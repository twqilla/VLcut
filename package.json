{
  "name": "vlcut",
  "version": "0.1.0",
  "description": "Free, local-first desktop video editor",
  "main": "out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc",
    "dist": "electron-vite build && electron-builder",
    "e2e": "node tests/e2e/app.e2e.cjs"
  },
  "keywords": [],
