    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "app.vlcut.editor",
    "productName": "VLcut",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "VLcut-Setup-${version}.${ext}",
      "icon": "resources/icon.ico"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/legal",
        "to": "legal"
      }
    ],
    "nsis": {
      "oneClick": "false",
      "allowToChangeInstallationDirectory": "true"
    },
    "linux": {
      "icon": "resources/icon.png"
    }
  },
  "homepage": "https://github.com/twqilla/vlcut"
}
